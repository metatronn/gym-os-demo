# ── Database ──
# Local: Docker Postgres (docker compose up -d)
# Production: Neon pooled and direct connection strings (neon.tech dashboard)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymosdev
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/gymosdev

# ── Auth ──
# Secret used for JWT session signing. A secure default is used in development.
# Generate a strong random value for production.
AUTH_SECRET=

# ── Payments (Stripe) ──
# Get test keys from stripe.com dashboard (toggle "Test mode")
# Leave empty until you work on billing features
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_TRIAL=

# ── Email (Resend) ──
# Get API key from resend.com dashboard
# Leave empty — emails will log to console
RESEND_API_KEY=
RESEND_FROM_EMAIL=GYM OS <onboarding@resend.dev>

# ── Background Jobs (Inngest) ──
# Not needed for local dev (npx inngest-cli dev handles it)
# Set these for Inngest Cloud in production
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# ── Error Tracking (Sentry) ──
# Not needed for local dev
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Analytics (PostHog) ──
# Not needed for local dev
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── Internal (Optional) ──
INTERNAL_SLACK_WEBHOOK_URL=
